---
const { title, keywords, description, pagecover, activeNav, Home } = Astro.props;
// 网站配置
import SITE_INFO from "@/config";
const { GoogleAds, Theme, HomeBanner } = SITE_INFO;
const { ad_Client, asideAD_Slot, articleAD_Slot } = GoogleAds;
// Head 依赖
import Head from "@/components/Head/Head.astro";
// 顶部 Header
import Header from "@/components/Header/Header.astro";
// Main 区域 Header
import MainHeader from "@/components/MainHeader/MainHeader.astro";
// Aside组件
import Aside from "@/components/Aside/Aside.astro";
// 底部 Footer
import Footer from "@/components/Footer/Footer.astro";
// 返回顶部
import BackTop from "@/components/BackTop/BackTop.astro";
// 手机端侧边栏
import MobileSidebar from "@/components/MobileSidebar/MobileSidebar.astro";
// A Modern CSS Reset
import "@/styles/Reset.less";
// 全局基础样式
import "@/styles/Base.less";
// Layout 样式
import "./Layout.less";
// Layout.astro
 
import { ClientRouter } from 'astro:transitions';
---

<html lang="zh-CN">
	<Head Title={title} Keywords={keywords} Description={description} PageCover={pagecover}>
		<!-- 谷歌广告JS加载项 -->
		// {ad_Client && (asideAD_Slot || articleAD_Slot) && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ad_Client}`} crossorigin="anonymous" />}
		<!-- 彩旗🎈 -->
		// <script is:inline src="/assets/js/vhCaiqi.js" defer></script>

		<!-- 卡片和文章图片处理 -->
		<script is:inline>
		document.addEventListener('error', function (e) {
		  const target = e.target;
		  if (target.tagName !== 'IMG' || target.dataset.errorHandled) return;
		  target.dataset.errorHandled = "true";
		
		  // 只判断是否是卡片封面、banner 或 avatar 区域
		  const isSpecialArea = 
		    target.classList.contains('vh-article-banner') ||
		    target.closest('.vh-article-banner') ||
		    target.closest('.post-card') ||
		    target.closest('.avatar');
		
		  // 只有这些区域才替换成随机图
		  if (isSpecialArea) {
		    const randomId = Math.floor(Math.random() * 10) + 1;
		    target.src = `/assets/images/random/default-${randomId}.webp`;
		    target.style.padding = '0';
		    target.style.objectFit = 'cover';
		
		    // 豁免模糊（如果 Base.less 还有模糊规则）
		    target.classList.add('img-error');  // 或 'loaded'，根据你的豁免逻辑
		
		    target.onerror = () => {
		      target.src = `/assets/images/random/default-1.webp`;
		      target.classList.add('img-error');
		      target.onerror = null;
		    };
		  }
		
		  // 文章里的图片或其他地方：什么都不做，让浏览器/lazyload 默认处理
		  // （可能显示破碎图标、问号，或保持模糊，根据你的库设置）
		
		}, true);
		</script>

		<!-- 设置主题颜色 -->
		<Fragment
			set:html={`<style>:root {${Object.entries(Theme)
				.map(([key, value]) => `${key}:${value};`)
				.join("")}--vh-main-header-height:${Home ? HomeBanner.HomeHeight : HomeBanner.PageHeight};--vh-home-banner:${HomeBanner.background}}</style>`}
		/>

	<ClientRouter fallback="swap" />

	<script is:inline>
	  document.addEventListener('touchstart', (e) => {
	    const a = e.target.closest('a');
	    if (a && a.href && a.host === window.location.host) {
	      // 动态创建一个 prefetch 链接
	      const link = document.createElement('link');
	      link.rel = 'prefetch';
	      link.href = a.href;
	      document.head.appendChild(link);
	    }
	  }, { passive: true });
	</script>

	</Head>
	<body>
		<MobileSidebar transition:persist />
		<Header activeNav={activeNav} transition:persist />
		<main class="main">
			{HomeBanner.enable && <MainHeader />}
			<section class="main-inner" style={`padding-top:${HomeBanner.enable ? "0.88rem" : "calc(66px + 0.68rem)"}`}>
				<section class="main-inner-content" transition:animate="none" >
					<slot />
				</section>
				<Aside />
			</section>
			<BackTop transition:persist />
		</main>
		<Footer transition:persist />
		<script>
		    import InitFn from "@/scripts/Init";
		    
		    document.addEventListener('astro:page-load', () => {
		        // 使用 requestIdleCallback，确保不阻塞转场动画
		        if ('requestIdleCallback' in window) {
		            window.requestIdleCallback(() => InitFn());
		        } else {
		            setTimeout(InitFn, 200); // 兼容方案
		        }
		    });
		</script>


        // 增加显示动画
	<div id="click-feedback" style="position:fixed; top:0; left:0; width:100vw; height:100vh; background:transparent; display:flex; align-items:center; justify-content:center; z-index:999999; opacity:0; pointer-events:none; transition:opacity 0.2s;">
	    <div class="logo-wrapper" style="position:relative; display:flex; align-items:center; justify-content:center;">
	        <div style="position:absolute; width:90px; height:90px; background:var(--vh-main-color, #409eff); filter:blur(20px); border-radius:50%; opacity:0.2; animation: logo-pulse 1s infinite ease-in-out;"></div>
	        
	        <img src="/assets/images/logo.png" alt="loading" style="width:40px; height:40px; object-fit:contain; position:relative; animation: logo-pulse 1s infinite ease-in-out;" />
	    </div>
	</div>
	
	<style is:global>
	    @keyframes logo-pulse {
	        0% { transform: scale(0.9); opacity: 0.4; }
	        50% { transform: scale(1.1); opacity: 1; }
	        100% { transform: scale(0.9); opacity: 0.4; }
	    }
	</style>
	
	<script is:inline>
	    // 点击链接即刻显示
	    document.addEventListener('astro:before-preparation', () => {
	        const feedback = document.getElementById('click-feedback');
	        if (feedback) {
	            feedback.style.opacity = '1';
	        }
	    });
	
	    // 页面完成加载即刻隐藏
	    document.addEventListener('astro:page-load', () => {
	        const feedback = document.getElementById('click-feedback');
	        if (feedback) {
	            feedback.style.opacity = '0';
	        }
	    });
	</script>

	</body>
</html>
